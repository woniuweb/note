filters:
  and:
    - file.ext == "md"
    - not:
        - file.inFolder("90模板")
formulas:
  modified_day: file.mtime.format("YYYY-MM-DD")
properties:
  type:
    displayName: 类型
  status:
    displayName: 状态
  formula.modified_day:
    displayName: 更新日期
views:
  - type: table
    name: 全部笔记
    order:
      - file.name
      - file.folder
      - type
      - status
      - formula.modified_day
  - type: table
    name: 收集与沉淀
    filters:
      or:
        - file.inFolder("01收集")
        - file.inFolder("05永久笔记")
    order:
      - file.name
      - file.folder
      - tags
      - formula.modified_day
